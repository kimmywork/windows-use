# WinUse 本地 git 仓库的忽略规则

# ---- 构建产物 ----
bin/
obj/
artifacts/
TestResults/

# ---- PoC 构建产物与运行产物 ----
poc/**/bin/
poc/**/obj/
# 运行日志与结果（开发过程产物；含机器名/窗口标题等个人数据，仅本地保留，不入库）
poc/poc-run.log
poc/log_*.txt
poc/l_*.txt
poc/notepad-diag.txt
poc/r_*.json
poc/result_*.json
poc/poc-input-results.json
poc/poc-results*.json
poc/poc-run-multimon.log

# ---- 本地工作区数据（含会话记忆，不入库）----
.workbuddy/

# ---- 系统 / 编辑器 ----
Thumbs.db
Desktop.ini
.vs/
.idea/
*.user
